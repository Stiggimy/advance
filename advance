#!/usr/bin/env bash
# ==============================================================================
# advance: Universal System Update Manager
# ==============================================================================

VERSION="0.10.0"
BUILD="95"

# Auto-detect source directory (handles symlinks seamlessly)
detect_source_dir() {
    local raw="$0"
    [[ "$raw" != */* ]] && raw="$(command -v "$raw" 2>/dev/null || echo "$raw")"
    local script_path
    script_path="$(readlink -f "$raw" 2>/dev/null || echo "$raw")"
    local script_dir
    script_dir="$(dirname "$script_path")"
    if git -C "$script_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
        SOURCE_DIR="$(git -C "$script_dir" rev-parse --show-toplevel)"
    else
        SOURCE_DIR="$script_dir"
    fi
}
detect_source_dir

# Ensure standard user tool directories are in PATH
for _p in "$HOME/.local/bin" "${CARGO_HOME:-$HOME/.cargo}/bin" "${PNPM_HOME:-$HOME/.local/share/pnpm}"; do
    [[ -d "$_p" && ":$PATH:" != *":$_p:"* ]] && PATH="$_p:$PATH"
done
unset _p

# Resolve XDG base directories (honours the user's environment)
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
_adv_data_dir="${ADVANCE_DATA_DIR:-$XDG_DATA_HOME/advance}"

# Resolve library directory (source checkout, XDG data dir, legacy per-user
# install, or a system-wide package install)
if [[ -d "$SOURCE_DIR/lib" ]]; then
    LIB_DIR="$SOURCE_DIR/lib"
elif [[ -d "$_adv_data_dir/lib" ]]; then
    LIB_DIR="$_adv_data_dir/lib"
elif [[ -d "$HOME/.local/lib/advance" ]]; then
    LIB_DIR="$HOME/.local/lib/advance"
elif [[ -d "/usr/lib/advance" ]]; then
    LIB_DIR="/usr/lib/advance"
elif [[ -d "/usr/share/advance/lib" ]]; then
    LIB_DIR="/usr/share/advance/lib"
else
    echo "ERROR: Could not locate Advance library directory (lib/)." >&2
    exit 1
fi
unset _adv_data_dir

# Load core modules in dependency order
source "$LIB_DIR/core.sh"
source "$LIB_DIR/xdg.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/plugins.sh"
source "$LIB_DIR/groups.sh"
source "$LIB_DIR/retry.sh"
source "$LIB_DIR/update.sh"

# Execute update workflow / CLI dispatcher
do_update "$@"
